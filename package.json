{
  "name": "spak",
  "version": "0.0.8",
  "description": "Spak - A multi-file service framework (Koishi-based monorepo facade)",
  "packageManager": "pnpm@10.8.0",
  "workspaces": [
    "packages/*"
  ],
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "node": {
        "import": "./lib/index.js",
        "require": "./lib/index.js"
      }
    },
    "./cli": "./bin.js",
    "./loader": "./packages/loader/lib/index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bash run/build.sh",
    "dev": "bash run/build.sh",
    "clean": "rm -rf lib packages/*/lib"
  },
  "bin": {
    "spak": "bin.js"
  },
  "license": "MIT",
  "dependencies": {
    "@spakjs/config": "workspace:^",
    "@spakjs/core": "workspace:^",
    "@spakjs/i18n": "workspace:^",
    "@spakjs/loader": "workspace:^",
    "@spakjs/log": "workspace:^",
    "@spakjs/message": "workspace:^",
    "@spakjs/util": "workspace:^",
    "cac": "^6.7.14",
    "kleur": "^4.1.5",
    "koishi": "^4.18.11"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.6.2"
  }
}
