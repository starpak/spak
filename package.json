{
  "name": "spak",
  "version": "0.1.0",
  "description": "Spak - 企业级 AI Agent 开发框架 (Koishi-based monorepo facade) - v0.1.0: Agent SDK 完成",
  "packageManager": "pnpm@10.8.0",
  "workspaces": [
    "packages/*"
  ],
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "node": {
        "import": "./lib/index.js",
        "require": "./lib/index.js"
      }
    },
    "./cli": "./bin.js",
    "./loader": "./packages/loader/lib/index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bash run/build.sh",
    "dev": "bash run/build.sh",
    "test": "mocha --require tsx \"packages/*/tests/*.spec.ts\"",
    "clean": "rm -rf lib packages/*/lib",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm build && pnpm test"
  },
  "bin": {
    "spak": "bin.js"
  },
  "license": "MIT",
  "dependencies": {
    "@spakjs/cli": "workspace:^",
    "@spakjs/config": "workspace:^",
    "@spakjs/core": "workspace:^",
    "@spakjs/i18n": "workspace:^",
    "@spakjs/loader": "workspace:^",
    "@spakjs/log": "workspace:^",
    "@spakjs/message": "workspace:^",
    "@spakjs/node-b": "workspace:^",
    "@spakjs/util": "workspace:^",
    "cac": "^6.7.14",
    "kleur": "^4.1.5",
    "koishi": "^4.18.11"
  },
  "devDependencies": {
    "@koishijs/plugin-mock": "^2.6.6",
    "@types/chai": "^5.2.3",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "chai": "^5.3.3",
    "chai-as-promised": "^8.0.2",
    "chai-shape": "^1.1.0",
    "mocha": "^11.8.0",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.2"
  }
}
