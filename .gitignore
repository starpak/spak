dist/
build/
target/
lib/

# TypeScript
*.tsbuildinfo
out/

# Logs and temp files
*.log
*.tmp
*.pid

# Environment variables
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Python (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
