{
  "name": "@spakjs/core",
  "description": "Core Features for Spak",
  "version": "0.0.7",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "author": "Spak Team",
  "license": "MIT",
  "keywords": [
    "spak",
    "framework"
  ],
  "dependencies": {
    "@spakjs/util": "workspace:^",
    "@spakjs/message": "workspace:^",
    "cordis": "^3.18.1",
    "cosmokit": "^1.8.1",
    "fastest-levenshtein": "^1.0.16",
    "js-yaml": "^4.1.0",
    "@spakjs/i18n": "workspace:^"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  }
}
