{
  "name": "@spakjs/cli",
  "description": "Spak CLI — serve / config / cpc commands and the createApp bootstrap for @spakjs/core",
  "version": "1.0.0",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "type": "commonjs",
  "bin": {
    "spak": "bin/spak.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "import": "./lib/index.js"
    },
    "./cli": {
      "require": "./lib/cli/index.js"
    },
    "./cli/firewall": {
      "require": "./lib/cli/firewall.js"
    },
    "./lib/cli/firewall": {
      "require": "./lib/cli/firewall.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@spakjs/util": "workspace:^",
    "@spakjs/config": "workspace:^",
    "@spakjs/i18n": "workspace:^",
    "@spakjs/log": "workspace:^",
    "@spakjs/loader": "workspace:^",
    "cac": "^6.7.14",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.6.2"
  }
}
