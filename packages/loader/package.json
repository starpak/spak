{
  "name": "@spakjs/loader",
  "description": "Config Loader for Spak",
  "version": "0.0.8",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "node": {
        "require": "./lib/index.js",
        "import": "./lib/index.js"
      },
      "browser": "./lib/shared.js"
    },
    "./shared": {
      "types": "./lib/shared.d.ts",
      "require": "./lib/shared.js",
      "import": "./lib/shared.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "author": "Spak Team",
  "license": "MIT",
  "keywords": [
    "spak",
    "loader",
    "config"
  ],
  "peerDependencies": {
    "@spakjs/core": "workspace:^"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  },
  "dependencies": {
    "@spakjs/core": "workspace:^",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "ns-require": "^1.1.4",
    "@spakjs/i18n": "workspace:^"
  }
}
