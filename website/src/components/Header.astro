---
import { SITE, NAV_ITEMS } from '../data/site';
import ThemeToggle from './islands/ThemeToggle.vue';
import MobileNav from './islands/MobileNav.vue';
const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name} 首页`}>
      <span class="brand-mark" aria-hidden="true">⚡</span>
      <span class="brand-name">{SITE.name}</span>
      <span class="brand-ver">v{SITE.version}</span>
    </a>
    <nav class="nav-desktop" aria-label="主导航">
      {NAV_ITEMS.map((item) => (
        <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]} title={item.desc}>{item.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <a href={SITE.repo} class="github-link" target="_blank" rel="noopener" aria-label="GitHub 仓库">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.4.5 0 5.9 0 12.5c0 5.3 3.4 9.8 8.2 11.4.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 4.6 18 4.9 18 4.9c.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.8-1.6 8.2-6.1 8.2-11.4C24 5.9 18.6.5 12 .5z"/></svg>
      </a>
      <ThemeToggle client:load />
      <MobileNav client:load items={NAV_ITEMS} currentPath={currentPath} />
    </div>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 100; height: var(--header-h); background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: saturate(180%) blur(12px); -webkit-backdrop-filter: saturate(180%) blur(12px); border-bottom: 1px solid var(--border); }
  .header-inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .brand { display: inline-flex; align-items: baseline; gap: .4rem; color: var(--text) !important; font-weight: 700; font-size: 1.15rem; letter-spacing: -.02em; }
  .brand-mark { font-size: 1.3rem; color: var(--brand-600); }
  .brand-ver { font-size: .7rem; font-family: var(--font-mono); color: var(--text-muted); background: var(--bg-soft); border: 1px solid var(--border); padding: .1em .4em; border-radius: 4px; }
  .nav-desktop { display: flex; align-items: center; gap: .25rem; }
  .nav-link { color: var(--text-soft) !important; padding: .5em .85em; border-radius: var(--radius-sm); font-size: .95rem; font-weight: 500; transition: all .15s ease; }
  .nav-link:hover { color: var(--text) !important; background: var(--bg-soft); }
  .nav-link.active { color: var(--brand-600) !important; background: var(--brand-50); }
  [data-theme='dark'] .nav-link.active { color: var(--brand-300) !important; background: rgba(139,92,246,.12); }
  .header-actions { display: flex; align-items: center; gap: .5rem; }
  .github-link { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: var(--radius-sm); color: var(--text-soft) !important; transition: all .15s ease; }
  .github-link:hover { color: var(--text) !important; background: var(--bg-soft); }
  @media (max-width: 768px) { .nav-desktop { display: none; } }
</style>
